# Copy to .env.local for local development. Never commit .env.local.

# Postgres connection string. The value below matches docker-compose.yml.
DATABASE_URL=postgres://cs:cs@localhost:5432/cs_invoices

# Password for the single owner login.
ADMIN_PASSWORD=change-me

# Random string used to sign the login cookie (16+ characters).
# Generate one with:  openssl rand -hex 32
AUTH_SECRET=replace-with-a-long-random-string
